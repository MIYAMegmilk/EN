# TURN サーバー（VPS 上の coturn）の接続情報。3つすべて設定すると /api/ice が TURN を配る
# 実値はここに書かず、サーバー側の .env にのみ置くこと（§3.8）

# TURN の URL 例: turn:example.com:3478
TURN_URL=
# TURN のユーザー名
TURN_USER=
# TURN のパスワード
TURN_PASS=

# Deno KV の保存先ファイルパス。
# 未設定なら Deno の既定位置（~/.cache/deno/ 配下。キャッシュ扱いのディレクトリなので
# deno のキャッシュ削除や OS の掃除で消える可能性がある。本番では指定を推奨）。
# 本番の推奨値: /var/lib/en/kv.sqlite3
# deno task start:prod の --allow-write=/var/lib/en に合わせ、/var/lib/en/ 配下にすること。
KV_PATH=

# 川柳判定（§3.10 せり）の kuromoji。既定は有効で、漢字混じりの句も拾う。
# 辞書はサーバープロセスに常駐して +220〜330MB になる（§6 では 400MB を見込む）。
# メモリが問題になったときは 0（false / off / no も可）で かなのみに倒せる。
# 倒すと せり は漢字混じりを拾えず、VC の文字起こし由来の句は検出されなくなる
EN_SENRYU_KUROMOJI=
