{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --watch server/main.ts",
    "start": "deno run --allow-net --allow-read --allow-env server/main.ts",
    "test": "deno test -A",
    "check": "deno check server/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "unstable": ["kv"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/http": "jsr:@std/http@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.2"
  },
  "lint": {
    "include": ["server/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["server/", "deno.json"],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false
  },
  "compilerOptions": {
    "strict": true
  }
}
